# Copiar a .env.local para desarrollo. En Vercel se cargan como Environment Variables.

# Destino de los envíos del formulario: un webhook que recibe POST JSON y guarda la
# fila (Google Sheets con Apps Script o Excel en OneDrive con Power Automate; ver
# docs/formulario.md). Sin esta variable, en desarrollo se loguea a consola y en
# producción el formulario responde con el mensaje de falla de envío.
LEADS_WEBHOOK_URL=

# URL pública del sitio, para metadatos y Open Graph absolutos.
NEXT_PUBLIC_SITE_URL=

# Mientras no sea "true", la página se sirve con noindex (metadata + cabecera).
NEXT_PUBLIC_SITE_LIVE=false
